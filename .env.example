# ─────────────────────────────────────────────────────────────────────────────
# FYIP TERMINAL — environment configuration (copy to .env.local)
# NEVER commit .env.local. All values here are server-side only unless they
# start with NEXT_PUBLIC_ (and none of the sensitive ones do).
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
FYIP_PORT=3000
# Absolute path to the SQLite database file. Defaults to ./data/fyip.db
FYIP_DB_PATH=./data/fyip.db

# Session signing secret. MUST be a long random string in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
FYIP_SESSION_SECRET=dev-only-insecure-change-me-please-0000000000000000

# First-run administrator account (created by migration if absent).
FYIP_ADMIN_EMAIL=admin@fyip.local
FYIP_ADMIN_PASSWORD=ChangeMe!12345

# Guest demo mode: POST /api/v1/auth/guest issues a read-only session
# (markets/news/calendar/analytics/portfolio + calculators only). Set to true to
# disable on private deployments.
FYIP_DISABLE_GUEST=false

# ── Development fixtures ─────────────────────────────────────────────────────
# When true, an explicitly-labelled SIMULATED provider emits deterministic
# pseudo-market data so the UI can be exercised without a live feed.
# This data is ALWAYS badged "SIMULATED" and must never be presented as live.
FYIP_ENABLE_FIXTURES=false

# ── NinjaTrader bridge ingestion ─────────────────────────────────────────────
# Shared secret the local bridge uses to authenticate POST /api/v1/bridge/ingest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FYIP_BRIDGE_TOKEN=dev-bridge-token-change-me
# Seconds without a heartbeat before a bridge feed is marked STALE.
FYIP_BRIDGE_STALE_SECONDS=8
# Seconds without a heartbeat before a bridge feed is marked DISCONNECTED.
FYIP_BRIDGE_DISCONNECT_SECONDS=30
# Retention for archived trade prints and depth snapshots (hours, 1..720).
FYIP_ORDERFLOW_RETENTION_HOURS=72

# ── External data providers (all optional; adapter returns UNAVAILABLE if unset)
FYIP_FINNHUB_API_KEY=
FYIP_ALPHAVANTAGE_API_KEY=
FYIP_POLYGON_API_KEY=
FYIP_FRED_API_KEY=
FYIP_NEWSAPI_API_KEY=
# FinancialJuice squawk/API stub: only enable if you hold an authorized entitlement.
# The public official headlines widget on /terminal/news does not use these values.
# See docs/PROVIDERS.md — no scraping is implemented.
FYIP_FINANCIALJUICE_API_KEY=
FYIP_FINANCIALJUICE_WS_URL=

# ── AI research assistant + FYP NEWS summaries (optional) ─────────────────────
# Set FYIP_AI_BASE_URL, FYIP_AI_API_KEY and FYIP_AI_MODEL to enable summaries
# of provider-supplied text. Must be an OpenAI-compatible chat-completions
# endpoint (HTTPS, except localhost for development). FYIP NEWS works fully
# without this.
FYIP_AI_PROVIDER=
FYIP_AI_BASE_URL=
FYIP_AI_API_KEY=
FYIP_AI_MODEL=

# Local-only FYP NEWS collector (runs every 60s while the server is up).
# Set to "off" to disable; Netlify uses request/SSE-triggered collection instead.
FYIP_NEWS_COLLECTOR=on

# ── Reference bridge (bridge/reference-bridge.mjs) ───────────────────────────
BRIDGE_TARGET_URL=http://localhost:3000/api/v1/bridge/ingest